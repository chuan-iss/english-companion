{
  "manifest_version": 3,
  "name": "English Companion · 网页取词",
  "version": "0.3.1",
  "description": "选区或输入框当前行 → 本机置顶窗口。仅在主动触发时传递文字。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:18743/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "获取选区 / 当前行"
  },
  "options_page": "options.html",
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "获取选区或输入框当前行",
      "global": true
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1/*",
        "https://chatgpt.com/*",
        "https://auth.openai.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
